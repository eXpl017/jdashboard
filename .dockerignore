# Keep the build context small and never bake local state or secrets in.
.git
.gitignore
.github
.venv
.pytest_cache
.ruff_cache
__pycache__
*.pyc
*.pyo

# Local runtime state (SQLite database, WAL files, logs)
data
logs
*.db
*.db-shm
*.db-wal

# Secrets / local configuration
.env

# Development-only files
tests
docs
.opencode
Makefile
PLAN.md
